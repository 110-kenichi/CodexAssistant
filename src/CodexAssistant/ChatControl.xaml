<UserControl x:Class="CodexAssistant.ChatControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
 Background="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}"
 Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}" MinWidth="280">
 <UserControl.Resources>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}"/>
   <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
   <Setter Property="Padding" Value="8"/>
  </Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,5"/><Setter Property="Margin" Value="3"/></Style>
 </UserControl.Resources>
 <Grid Margin="10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,8">
   <TextBlock Text="Codex Assistant" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock Text="Solutionとエディター情報を自動取得 · 読み取り専用" TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0"/>
   <TextBlock Text="モデル" Margin="0,10,0,3"/>
   <DockPanel>
    <Button DockPanel.Dock="Right" x:Name="SaveModel" Content="保存" Click="SaveModel_Click" ToolTip="VSIX内のモデル選択を保存"/>
    <ComboBox x:Name="ModelPicker" IsEditable="True" IsTextSearchEnabled="False" MinHeight="30" VerticalContentAlignment="Center"
              AutomationProperties.Name="モデル選択またはモデルID入力" ToolTip="候補から選択、またはモデルIDを直接入力。利用可否はCLIとアカウントに依存します。"/>
   </DockPanel>
   <TextBlock Text="モデルIDを直接入力可 · 保存またはSendで記憶" TextWrapping="Wrap" Opacity="0.75" Margin="0,3,0,0"/>
  </StackPanel>
  <TabControl Grid.Row="1" x:Name="Tabs">
   <TabItem Header="Chat"><TextBox x:Name="History" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Text="Solutionを開き、質問を入力してください。コードの選択は不要です。"/></TabItem>
   <TabItem Header="Context"><TextBox x:Name="ContextView" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></TabItem>
   <TabItem Header="Proposed diff">
    <DockPanel>
     <WrapPanel DockPanel.Dock="Bottom">
      <Button Content="Save diff" x:Name="SaveDiff" Click="SaveDiff_Click" IsEnabled="False"/>
      <Button Content="Apply (未実装)" IsEnabled="False" ToolTip="この版では自動適用しません。保存したdiffを確認して適用してください。"/>
      <Button Content="Reject" x:Name="Reject" Click="Reject_Click" IsEnabled="False"/>
     </WrapPanel>
     <TextBox x:Name="DiffView" IsReadOnly="True" FontFamily="Consolas" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="0"/>
    </DockPanel>
   </TabItem>
  </TabControl>
  <TextBox Grid.Row="2" x:Name="Input" Margin="0,10,0,4" Height="95" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" PreviewKeyDown="Input_KeyDown" AutomationProperties.Name="Codexへの質問"/>
  <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
   <Button Content="New chat" x:Name="NewChat" Click="NewChat_Click"/>
   <Button Content="Context更新" x:Name="Refresh" Click="Refresh_Click"/>
   <Button Content="Cancel" x:Name="Cancel" Click="Cancel_Click" IsEnabled="False"/>
   <Button Content="Send" x:Name="Send" Click="Send_Click" IsDefault="False"/>
  </WrapPanel>
  <TextBlock Grid.Row="4" x:Name="Status" Text="Ctrl+Enterで送信 · 設定: Tools → Options → Codex Assistant" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.75"/>
 </Grid>
</UserControl>
